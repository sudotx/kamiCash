// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("LOCAL_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatusEnum {
  ACTIVE
  SUSPENDED
  BANNED
  INACTIVE
  DELETED
}

enum RoleEnum {
  ADMIN
  USER
}

enum EntryType {
  CREDIT
  DEBIT
}

enum TransactionType {
  DEPOSIT // For adding money to account
  WITHDRAWAL // For taking money out
  TRANSFER // For internal transfers
  PAYMENT // For merchant payments
  REFUND // For refunds
  FEE // For system fees
}

enum TransactionStatus {
  PENDING
  PROCESSING // Added for multi-step transactions
  COMPLETED
  FAILED
  REVERSED // Added for chargeBacks/refunds
  CANCELLED
}

enum KycStatus {
  NONE
  PENDING
  IN_REVIEW
  REJECTED
  VERIFIED
}

enum FiatType {
  USD
  NGN
  GHS
  CFA
  EUR
  GBP
}

enum AssetType {
  USDT
  USDC
  DAI
  USDe
  PYUSD
  RLUSD
}

enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  CRYPTO
  MOBILE_MONEY
}

model KycData {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  idType             String // passport, national_id, drivers_license
  idNumber           String
  dateOfBirth        DateTime  @default(now())
  nationality        String    @default("")
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  country            String
  postalCode         String
  documentUrls       String[] // Array of verification document URLs
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  submittedAt        DateTime  @default(now())
  verifiedAt         DateTime?
  expirationDate     DateTime?
  verifiedBy         String?
  riskScore          Int?
  rejectionReason    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt()

  @@index([userId])
  @@index([verificationStatus])
}

model UserAddress {
  id         String   @id @default(uuid())
  street     String
  city       String
  state      String
  country    String
  zipCode    String
  isApproved Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  password             String
  firstName            String
  lastName             String
  phoneNumber          String
  dateOfBirth          DateTime
  nationality          String
  role                 RoleEnum          @default(USER)
  accountStatus        AccountStatusEnum @default(ACTIVE)
  isKyc                Boolean           @default(false)
  kycStatus            KycStatus         @default(NONE)
  kycData              KycData?
  emailVerified        Boolean           @default(false)
  phoneVerified        Boolean           @default(false)
  twoFactorEnabled     Boolean           @default(false)
  twoFactorSecret      String?
  solanaAddress        String?           @unique
  solanaPrivateKey     String?           @unique
  evmAddress           String?           @unique
  evmPrivateKey        String?           @unique
  points               Int               @default(0)
  referralCode         String?           @unique
  tier                 Int               @default(1)
  referredBy           String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt()
  lastLogin            DateTime?
  failedLoginAttempts  Int               @default(0)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  cards                Card[]
  sentTransactions     Transaction[]     @relation("SenderTransactions")
  receivedTransactions Transaction[]     @relation("ReceiverTransactions")
  virtualAccount       VirtualAccount[]
  LedgerEntry          LedgerEntry[]
  otps                 OTP[]
  userAddresses        UserAddress[]
  loginSession         LoginSession[]
  notification         Notification[]
}

model LoginSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  deviceInfo   Json // Store device fingerprint
  ipAddress    String
  lastActivity DateTime @default(now())
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

model Card {
  id             String   @id @default(cuid())
  userId         String
  last4          String
  brand          String
  expiryMonth    String
  expiryYear     String
  token          String? // For storing tokenized card info
  isDefault      Boolean  @default(false)
  failedAttempts Int      @default(0)
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()

  @@index([userId])
  @@index([token])
}

model Transaction {
  id               String            @id @default(cuid())
  fromUserId       String
  toUserId         String?
  toAddress        String?
  amount           Decimal
  fee              Decimal           @default(0)
  netAmount        Decimal
  assetType        AssetType
  fiatType         FiatType
  type             TransactionType
  paymentMethod    PaymentMethodType
  status           TransactionStatus
  txHash           String? // For blockchain transactions
  fromUser         User              @relation("SenderTransactions", fields: [fromUserId], references: [id])
  toUser           User?             @relation("ReceiverTransactions", fields: [toUserId], references: [id])
  memo             String?
  reference        String?
  metadata         Json?
  failureReason    String?
  processingSteps  Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt()
  completedAt      DateTime?
  VirtualAccount   VirtualAccount?   @relation(fields: [virtualAccountId], references: [id])
  virtualAccountId String?
  LedgerEntry      LedgerEntry[]
}

model OTP {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id])
}

model VirtualAccount {
  id               String                @id @default(uuid())
  accountNumber    String                @unique
  accountName      String
  balance          Decimal               @default(0)
  availableBalance Decimal               @default(0)
  currency         String
  status           String                @default("ACTIVE")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  // Relations
  userId           String
  user             User                  @relation(fields: [userId], references: [id])
  transactions     Transaction[]
  limits           VirtualAccountLimits?
  ledgerEntry      LedgerEntry[]

  // Indexes
  @@index([userId])
  @@index([accountNumber])
}

model VirtualAccountLimits {
  id               String  @id @default(uuid())
  dailyLimit       Decimal
  monthlyLimit     Decimal
  transactionLimit Decimal

  // Relations
  virtualAccountId String         @unique
  virtualAccount   VirtualAccount @relation(fields: [virtualAccountId], references: [id])
}

model LedgerEntry {
  id          String    @id @default(uuid())
  entryType   EntryType // CREDIT, DEBIT
  amount      Decimal
  usdcAmount  Decimal // Equivalent USDC amount
  balance     Decimal // Running balance
  description String
  status      String    @default("COMPLETED")
  createdAt   DateTime  @default(now())

  // Relations
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  virtualAccountId String
  virtualAccount   VirtualAccount @relation(fields: [virtualAccountId], references: [id])
  transactionId    String?
  transaction      Transaction?   @relation(fields: [transactionId], references: [id])

  // Metadata
  metadata Json?

  @@index([userId])
  @@index([virtualAccountId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // EMAIL, SMS, PUSH
  title     String
  message   String
  isRead    Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
